(title_block (title "be6502 - W65C816S breadboard computer") (date "2026-10-16") (rev "1") (company "be6502") (comment 1 "W65C816S breadboard computer - see README.md and pld/decode.pld") (comment 2 "Active-low signals use KiCad overbar notation, e.g. ~{IOSEL}"))
(lib_symbols )
(text "Memory map (24-bit, bank:offset)\n  $00:0000-$00:5FFF   RAM  (U5)\n  $00:6000-$00:7FFF   I/O window, U7 '138, 8 x 1 KB slots\n                       $6000 VIA (U8), $7000 ACIA (U9)\n  $00:8000-$00:FFFF   ROM  (U4)\n  $01:0000-$07:FFFF   RAM  (U5)\n  $08:0000-$7F:FFFF   aliases of banks $00-$07\n  $80:0000-$80:7FFF   video RAM (U6), aliased through $FF:FFFF\n\nNaming: active-low signals are drawn with an overbar, e.g. ~{IOSEL}, ~{RAMCE}, R/~{W}.\nThe W65C datasheets write these with a B suffix (IRQB, RESB, RWB, CS2B);\ndecode.pld writes them with a leading '/' in its equations." (at 25.4 76.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 2a9fdd14-ad73-5b6b-9647-5aaf1648a4b4))
